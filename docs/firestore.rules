rules_version = '2';

// Chaque personne ne voit que ses propres données, et seule l'adresse ci-dessous peut en créer.
// Remplace TON_ADRESSE_GOOGLE par l'adresse du compte Google avec lequel tu te connectes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'TON_ADRESSE_GOOGLE';
    }
  }
}
